== Resultados esperados
  [PASSOU] c1 autenticado (ubuntu-ied-1)
  [PASSOU] c2 autenticado (ubuntu-ied-2)
  [PASSOU] c1 alcança c2 após autenticar
  [PASSOU] c2 alcança c1 após autenticar
-- E1: sem 802.1X + MAC clonado do IED 1
  [PASSOU] c3 não alcança c2
  [PASSOU] c2 não alcança c3 (porta não autorizada não recebe)
  [PASSOU] descarte de c3 registrado (quadro_descartado)
-- E2: certificado revogado
  [PASSOU] c4 rejeitado: certificado_revogado
  [PASSOU] c4 não alcança c2
-- E3: cert válido de outro dispositivo + MAC do IED 1
  [PASSOU] c5 rejeitado: mac_divergente
  [PASSOU] c5 não alcança c2
  [PASSOU] p5 (MAC clonado) nunca chegou a ser autorizado
-- E4: cert válido + MAC próprio (limite do 802.1X)
  [PASSOU] c6 autenticado (atacante-comprometido)
  [PASSOU] c6 alcança c2
  [PASSOU] c6 com MAC forjado pós-autenticação não alcança c2 (anti-spoof por porta)
  [PASSOU] c6 volta a alcançar c2 com o MAC autenticado
-- Outros motivos
  [PASSOU] c7 rejeitado: cn_fora_do_inventario
  [PASSOU] c8 rejeitado: certificado_invalido (CA falsa)
  [PASSOU] c9 rejeitado: sem_certificado
  [PASSOU] c8 não alcança c2
-- Queda de link revoga a sessão e reautenticação restaura
  [PASSOU] sessão de p1 encerrada ao cair o link
  [PASSOU] c1 reautentica sozinho e volta a alcançar c2
-- CRL: revogar com o autenticador em operação
  [PASSOU] ubuntu-ied-2 revogado em operação: rejeitado na reautenticação
  [PASSOU] c1 não alcança mais c2 (sessão revogada)
  [PASSOU] c1 (não revogado) segue alcançando c6
-- E0: sem 802.1X (autenticador-ctl desativar) e reativação
  [PASSOU] sem 802.1X: c3 (sem credencial, MAC clonado) alcança c6
  [PASSOU] reativado: c3 volta a ser bloqueado
  [PASSOU] reativado: c1 e c6 reautenticam (supplicant reiniciado) e c6 alcança c1

== Estado final do nftables
table bridge acesso8021x {
	counter descartes_saida {
		packets 7 bytes 196
	}

	set autorizados {
		type ifname . ether_addr
		elements = { "p1" . 02:00:c0:a8:0a:0b,
			     "p6" . 02:00:c0:a8:0a:28 }
	}

	set portas_autorizadas {
		type ifname
		elements = { "p1",
			     "p6" }
	}

	set portas_confiaveis {
		type ifname
	}

	set descartados {
		type ifname . ether_addr
		size 1024
		flags dynamic,timeout
		counter
		timeout 2m
		elements = { "p3" . 02:00:c0:a8:0a:0b counter packets 2 bytes 168 expires 1m53s850ms,
			     "p6" . 02:00:c0:a8:0a:28 counter packets 6 bytes 168 expires 1m55s898ms }
	}

	chain saida {
		oifname @portas_confiaveis accept
		oifname @portas_autorizadas accept
		counter name "descartes_saida" drop
	}

	chain forward {
		type filter hook forward priority 0; policy drop;
		iifname @portas_confiaveis goto saida
		iifname . ether saddr @autorizados goto saida
		update @descartados { iifname . ether saddr } counter packets 8 bytes 336 drop
	}
}
